# ===== Dependencies =====
node_modules/

# ===== Build output =====
dist/
dist-ssr/
*.local

# ===== Environment files (CONTAINS SECRETS - DO NOT COMMIT) =====
.env
.env.local
.env.*.local
*.env

# ===== Logs =====
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ===== Editor / IDE =====
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ===== OS =====
.DS_Store
Thumbs.db
Desktop.ini

# ===== Test screenshots (optional, can be large) =====
test_screenshots/

# ===== Database backups =====
# Ignore raw .bak (too large for GitHub), but allow compressed .bak.gz
server/db-backups/*.bak
!server/db-backups/*.bak.gz
server/db/export.sql
server/db/*.bak

# ===== Temporary files =====
*.tmp
*.temp
